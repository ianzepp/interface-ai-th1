#!/bin/sh
set -eu

# Point this clone's core.hooksPath at the versioned hooks in scripts/hooks.
# Usage: scripts/install-hooks
#
# Git never shares hooks through history, so this is a per-clone step.
#
# INVARIANTS
# - Idempotent: rerunning over its own configuration changes nothing.
# - Refuses to replace a hooksPath it did not set, because silently disabling
#   someone else's hooks is worse than not installing these.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "install-hooks: not inside a Git work tree" >&2
    exit 1
fi

configured=$(git config --get core.hooksPath || true)
if [ -n "$configured" ] && [ "$configured" != "scripts/hooks" ]; then
    echo "install-hooks: core.hooksPath is already '$configured'." >&2
    echo "install-hooks: refusing to replace it. Point it at scripts/hooks" >&2
    echo "install-hooks: yourself if the hooks there should chain instead." >&2
    exit 1
fi

git config core.hooksPath scripts/hooks
echo "install-hooks: core.hooksPath -> scripts/hooks"
echo "install-hooks: undo with: git config --unset core.hooksPath"
