#!/bin/sh
set -eu

# Run the browser session CLI, building only when it has never been built.
# Usage: scripts/session [arguments]
# Arguments pass through unchanged to src/authoring/session-cli.ts.
#
# INVARIANTS
# - No build per call: the authoring model calls this once per browser action,
#   so a build each time would dominate the run. scripts/author builds before a
#   session starts; the build here covers a first use on a clean checkout.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

if [ ! -f dist/src/authoring/session-cli.js ]; then
    npm run build --silent
fi
exec node dist/src/authoring/session-cli.js "$@"
