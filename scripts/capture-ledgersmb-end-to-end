#!/bin/sh
set -eu

# Capture the LedgerSMB pilot runs end to end from a fresh install.
# Usage: scripts/capture-ledgersmb-end-to-end
#
# Rebuilds, replaces the default LedgerSMB instance with a clean one, then runs
# the initialize, partners, catalog, and lifecycle pilots in that order. Each
# pilot depends on the state the previous one left behind.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

npm run build --silent
scripts/target fresh ledgersmb
node dist/src/authoring/ledgersmb-initialize-pilot.js
node dist/src/authoring/ledgersmb-partners-pilot.js
node dist/src/authoring/ledgersmb-catalog-pilot.js
node dist/src/authoring/ledgersmb-lifecycle-pilot.js
