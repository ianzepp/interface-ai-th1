#!/bin/sh
set -eu

# A scripted stand-in for the operator console the assignment allows mocking.
# Usage:
#   scripts/mock-operator --lane <lane> --rationale <text> [--timeout <seconds>] \
#       -- <human-act action flags>
# Example:
#   scripts/mock-operator --lane demo --rationale "Open the caller's account" \
#       -- --type navigate --url 'http://127.0.0.1:8080/societe/card.php?socid=58'
#
# Waits for the lane's session to hand control to a human, observes the live
# page, performs one human action in that same browser, then asks automation to
# validate the state and take control back.
#
# INVARIANTS
# - Every step goes through scripts/session, so the ledger records it as human
#   activity under the human's lease epoch, as it would for a person.
#
# EXIT CODES
# - 1: no handoff within --timeout seconds.
# - 2: usage error.
# - Otherwise, the status of the first scripts/session step that failed.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

say() { printf '[operator] %s\n' "$*"; }

lane=""
rationale=""
timeout=600
while [ $# -gt 0 ]; do
    case "$1" in
        --lane) lane=$2; shift 2 ;;
        --rationale) rationale=$2; shift 2 ;;
        --timeout) timeout=$2; shift 2 ;;
        --) shift; break ;;
        *) echo "mock-operator: unknown flag $1" >&2; exit 2 ;;
    esac
done
if [ -z "$lane" ] || [ -z "$rationale" ] || [ $# -eq 0 ]; then
    echo "usage: scripts/mock-operator --lane <lane> --rationale <text> [--timeout <seconds>] -- <human-act action flags>" >&2
    exit 2
fi

say "waiting for lane $lane to hand control to a human"
waited=0
until scripts/session status --lane "$lane" 2>/dev/null | grep -q '^controller: human$'; do
    if [ "$waited" -ge "$timeout" ]; then
        say "no handoff within ${timeout}s"
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

say "control received; the intervention request is on the run's ledger"
scripts/session status --lane "$lane"

say "looking at the live page"
scripts/session human-observe --lane "$lane" --screenshot | sed -n '1,4p'

say "acting: $rationale"
scripts/session human-act --lane "$lane" --rationale "$rationale" "$@"

say "asking automation to validate the state and resume"
scripts/session resume --lane "$lane"
