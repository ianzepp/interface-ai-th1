#!/usr/bin/env bash
set -Eeuo pipefail

# Run one authoring session against a private target instance and a private
# copy of the repository. Usage: scripts/author-lane --help
#
# This is the outer lifecycle, not the authoring loop: it restores a lane's
# Docker instance to a named snapshot, prepares the lane's worktree, hands the
# goal to the authoring CLI, then destroys the instance. How to author is
# decided entirely inside the Codex session that CLI launches.
#
# INVARIANTS
# - Target isolation: a lane gets its own Compose project, volumes, and host
#   port, because a target's default instance pins all three.
# - Workspace isolation: lanes sharing one tree collide on capability files,
#   dist/, and package.json, and each sees the others' edits in git status.
# - The worktree is committed to a baseline before the session, so its
#   git status and diff against that baseline are exactly the lane's output.
# - Teardown (skipped with --keep) destroys only the lane's instance. The
#   workspace is kept, because it holds the artifact.

ROOT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIRECTORY}"

usage() {
    cat <<'EOF'
Usage:
  scripts/author-lane --lane <name> --target <ledgersmb|dolibarr> \
                      --fixture <snapshot> --goal <text> [options]

Provisions an isolated Docker instance and an isolated workspace for the lane,
runs one authoring session with Codex against them, then tears the instance down.

Required:
  --lane <name>        Lane name. Lowercase letters, digits, and hyphens.
  --target <name>      ledgersmb or dolibarr.
  --fixture <snapshot> Snapshot to start from, without the target prefix.
  --goal <text>        The capability goal.

Isolation:
  --workspace <path>   Worktree for this lane. Defaults to
                       worktrees/<lane>.
  --no-isolation       Run against the shared working tree instead. Only safe
                       when no other lane is running.
  --port <n>           Host port for this lane. Defaults to a port derived from
                       the lane name.
  --keep               Leave the Docker instance running afterwards, and print
                       how to inspect or remove it.
  --no-author          Provision and tear down without running a session.
  --audit              Review what the lane produced before tearing down. Runs a
                       second Codex as an independent reviewer, and reports
                       rather than repairing, so the artifact stays as the author
                       wrote it. Needs workspace isolation so the lane's output
                       can be told apart from everything else.

Forwarded to scripts/author:
  --model <model>      Model passed to codex exec.
  --reasoning-effort <level>  low, medium, high, xhigh, ultra, or max.
  --max-runs <n>       Recorded runs allowed in total. Defaults to 8, which
                       leaves room for the happy path plus a failure matrix.
  --max-actions <n>    Browser actions allowed per run.
  --timeout <ms>       Whole-session budget.
  --codex-sandbox <m>  read-only, workspace-write, or danger-full-access.
  --preflight          Verify the session transport only.

Afterwards:
  The lane's worktree holds the artifact and its runs, and the baseline commit it
  is measured against is printed as it is created. Inspect the lane's own work
  with `git -C <workspace> status --short` and `git -C <workspace> diff`.

Examples:
  scripts/author-lane --lane lookup --target dolibarr \
    --fixture demo-install-smoke --goal "Look up a third party by exact name."

  scripts/author-lane --lane effort-high --target dolibarr \
    --fixture demo-install-smoke --reasoning-effort high --goal "..."
EOF
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

# Destroy the lane's instance on exit, keeping the exit status. Registered
# before provisioning and before the workspace exists, so a failure in either
# still cleans up the Docker instance.
lane_teardown() {
    local status=$?
    printf '\nTearing down lane %s\n' "${lane_name}"
    if ! scripts/target destroy --lane "${lane_name}" \
        --port "${lane_port}" "${target_name}"; then
        printf 'warning: lane %s teardown failed; inspect it with:\n' "${lane_name}" >&2
        printf '  scripts/target status --lane %s %s\n' "${lane_name}" "${target_name}" >&2
    fi
    return "${status}"
}

# Build the lane's private tree as a git worktree holding the current working
# state, committed as the lane's baseline.
#
# A worktree rather than a source copy: git shares the object store, and
# `git worktree remove` retires it cleanly. HEAD alone is not enough because the
# harness may be uncommitted, so the working state is copied in and committed
# inside the worktree. That commit uses the lane's own HEAD and index; the
# shared tree's index and refs are never touched.
prepare_workspace() {
    if [[ "${workspace}" == "${ROOT_DIRECTORY}" ]]; then
        printf 'Using the shared working tree (isolation disabled)\n'
        return 0
    fi

    # A previous lane's workspace is moved to the trash rather than deleted, so a
    # mistaken lane name cannot destroy the artifact of a run still worth reading.
    command -v trash >/dev/null 2>&1 ||
        fail "the 'trash' command is required to replace an existing lane workspace"
    if [[ -e "${workspace}" ]]; then
        trash "${workspace}" ||
            fail "could not move the previous workspace aside"
        git worktree prune
    fi
    mkdir -p "$(dirname "${workspace}")"

    git worktree add --detach "${workspace}" HEAD >/dev/null ||
        fail "could not create the lane worktree at ${workspace}"

    tar -C "${ROOT_DIRECTORY}" \
        --exclude ./node_modules \
        --exclude ./dist \
        --exclude ./runs \
        --exclude ./tmp \
        --exclude ./.git \
        --exclude ./snapshots \
        --exclude ./worktrees \
        -cf - . | tar -C "${workspace}" -xf -

    # Ignored state the lane still needs: dependencies (large, read only), the
    # snapshot archives (a copy, because Docker bind-mounts this path), and its
    # own run and temporary roots.
    ln -sfn "${ROOT_DIRECTORY}/node_modules" "${workspace}/node_modules"

    # Copy the snapshot *contents*: the worktree already has `snapshots/` because
    # `snapshots/README.md` is tracked, so copying the directory would nest one
    # level too deep. The check exists because that failure otherwise surfaces
    # from scripts/target as "snapshot does not exist".
    mkdir -p "${workspace}/snapshots"
    cp -a "${ROOT_DIRECTORY}/snapshots/." "${workspace}/snapshots/"
    [[ -d "${workspace}/snapshots/${target_name}/${fixture_name}" ]] ||
        fail "lane snapshot copy is wrong: ${workspace}/snapshots/${target_name}/${fixture_name} is missing"
    [[ -d "${workspace}/node_modules" ]] ||
        fail "lane dependency link is broken: ${workspace}/node_modules"

    mkdir -p "${workspace}/runs" "${workspace}/tmp"

    git -C "${workspace}" add -A >/dev/null
    git -C "${workspace}" \
        -c user.name="author-lane" \
        -c user.email="author-lane@localhost" \
        commit -q --no-verify -m "lane ${lane_name}: baseline" ||
        fail "could not create the lane baseline commit"
    local base_commit
    base_commit="$(git -C "${workspace}" rev-parse HEAD)"

    printf 'Workspace: %s (worktree, baseline %s)\n' \
        "${workspace}" "${base_commit:0:12}"
}

lane_name=""
target_name=""
fixture_name=""
goal_text=""
lane_port=""
workspace=""
keep_instance=0
run_author=1
run_audit=0
forwarded_arguments=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --lane)
            [[ $# -ge 2 ]] || fail "--lane requires a name"
            lane_name="$2"
            shift 2
            ;;
        --target)
            [[ $# -ge 2 ]] || fail "--target requires a name"
            target_name="$2"
            shift 2
            ;;
        --fixture)
            [[ $# -ge 2 ]] || fail "--fixture requires a snapshot name"
            fixture_name="$2"
            shift 2
            ;;
        --goal)
            [[ $# -ge 2 ]] || fail "--goal requires text"
            goal_text="$2"
            shift 2
            ;;
        --port)
            [[ $# -ge 2 ]] || fail "--port requires a number"
            lane_port="$2"
            shift 2
            ;;
        --workspace)
            [[ $# -ge 2 ]] || fail "--workspace requires a path"
            workspace="$2"
            shift 2
            ;;
        --keep)
            keep_instance=1
            shift
            ;;
        --no-author)
            run_author=0
            shift
            ;;
        --audit)
            run_audit=1
            shift
            ;;
        --no-isolation)
            workspace="${ROOT_DIRECTORY}"
            shift
            ;;
        help | --help | -h)
            usage
            exit 0
            ;;
        --model | --reasoning-effort | --max-runs | --max-actions | --timeout | --codex-sandbox)
            [[ $# -ge 2 ]] || fail "$1 requires a value"
            forwarded_arguments+=("$1" "$2")
            shift 2
            ;;
        --preflight)
            forwarded_arguments+=("$1")
            shift
            ;;
        *)
            fail "unknown option '$1' (run scripts/author-lane --help)"
            ;;
    esac
done

[[ -n "${lane_name}" ]] || fail "--lane is required"
[[ -n "${target_name}" ]] || fail "--target is required"
[[ -n "${fixture_name}" ]] || fail "--fixture is required"
if ((run_author == 1)); then
    [[ -n "${goal_text}" ]] || fail "--goal is required"
fi
[[ -n "${workspace}" ]] || workspace="${ROOT_DIRECTORY}/worktrees/${lane_name}"
if ((run_audit == 1)) && [[ "${workspace}" == "${ROOT_DIRECTORY}" ]]; then
    fail "--audit needs workspace isolation to tell the lane's output from the rest"
fi

# This process owns the lane for its whole life, so its pid is the one that
# keeps the port reservation live. It must be exported before reserve-port runs,
# or the lock records scripts/target's own pid and looks stale immediately.
export LANE_OWNER_PID="$$"

# An explicit --port is already the reservation. Otherwise scripts/target
# reserves one, so the port arithmetic lives in one place and the origin passed
# to the author matches the instance that actually starts.
[[ -n "${lane_port}" ]] ||
    lane_port="$(scripts/target reserve-port --lane "${lane_name}" "${target_name}")"
origin="http://127.0.0.1:${lane_port}"

printf 'Lane %s: %s on port %s\n' "${lane_name}" "${target_name}" "${lane_port}"

if ((keep_instance == 0)); then
    trap lane_teardown EXIT INT TERM
fi

prepare_workspace

# Everything below runs inside the lane's workspace, so the fixture receipt, the
# build output, the run directories, and the session state all land there.
cd "${workspace}"

# Provisioning is the checkpoint restore, so the lane starts from exactly the
# named state rather than from whatever the previous scenario left behind.
scripts/target reset --lane "${lane_name}" --port "${lane_port}" \
    "${target_name}" "${fixture_name}"

if ((run_author == 0)); then
    printf '\nSkipping the authoring session (--no-author).\n'
    printf 'Lane is live at %s\n' "${origin}"
    exit 0
fi

if ((keep_instance == 1)); then
    printf '\nLeaving the lane running (--keep). Inspect or remove it with:\n'
    printf '  scripts/target status --lane %s %s\n' "${lane_name}" "${target_name}"
    printf '  scripts/target destroy --lane %s %s\n' "${lane_name}" "${target_name}"
fi

npm run build --silent

node dist/src/authoring/author-cli.js \
    --goal "${goal_text}" \
    --target "${target_name}" \
    --fixture "${fixture_name}" \
    --lane "${lane_name}" \
    --origin "${origin}" \
    ${forwarded_arguments[@]+"${forwarded_arguments[@]}"}

# The lane's own output: capability sources changed since its baseline.
produced="$(git -C "${workspace}" status --porcelain |
    awk '{print $2}' | grep '^src/capabilities/.*\.ts$' || true)"

# A session that produced no capability has failed, however quietly it exited.
lane_status=0
if [[ -z "${produced}" ]]; then
    printf '\nerror: the session produced no capability artifact\n' >&2
    lane_status=1
fi

# Optional independent review. Opt-in because it costs a second model pass, and
# it reports rather than repairs, so the artifact is left exactly as authored.
if ((run_audit == 1)); then
    printf '\nAuditing what lane %s produced\n' "${lane_name}"
    if [[ -z "${produced}" ]]; then
        printf 'no capability artifact was produced, so there is nothing to audit\n'
    else
        # Word splitting is intended: one repository-relative path per word.
        for source_path in ${produced}; do
            scripts/audit-artifact --source "${source_path}" --model-review ||
                lane_status=$?
        done
    fi
fi

if [[ "${workspace}" != "${ROOT_DIRECTORY}" ]]; then
    printf '\n--- lane %s workspace ---\n' "${lane_name}"
    printf 'path: %s\n' "${workspace}"
    printf 'capability artifacts produced: %s\n' "$(printf '%s' "${produced}" | wc -w | tr -d ' ')"
    printf 'changed files:\n'
    git -C "${workspace}" status --short | sed 's/^/  /' || true
    printf 'diffstat:\n'
    git -C "${workspace}" diff HEAD --stat | sed 's/^/  /' || true
fi

exit "${lane_status}"
