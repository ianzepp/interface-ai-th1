#!/bin/sh
set -eu

# Refuse a commit whose staged content carries a credential value.
# Installed per clone by scripts/install-hooks; rules and limits are in
# SECURITY.md. Escape hatch, deliberately explicit: git commit --no-verify
#
# INVARIANTS
# - Scans the index, not the working tree: the commit is what ships. Content
#   staged and then edited is still in the commit; unstaged edits are not.
# - Scans the repository being committed even when core.hooksPath is absolute:
#   Git runs the hook from the work tree root, and that root is passed as --root.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

if ! command -v npm >/dev/null 2>&1; then
    echo "pre-commit: npm is not on PATH, so the credential scan cannot run." >&2
    echo "pre-commit: repair the toolchain, or commit with --no-verify to skip." >&2
    exit 1
fi

exec "$project_dir/scripts/audit-secrets" --root "$(pwd)" --staged
