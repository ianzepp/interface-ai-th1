#!/bin/sh
set -eu

# Build the project, then run the capability artifact audit.
# Usage: scripts/audit-artifact [arguments]
# Arguments pass through unchanged to src/audit/audit-cli.ts.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

npm run build --silent
exec node dist/src/audit/audit-cli.js "$@"
