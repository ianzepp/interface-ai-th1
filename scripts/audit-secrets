#!/bin/sh
set -eu

# Build the project, then run the credential scan.
# Usage: scripts/audit-secrets [arguments]
# Arguments pass through unchanged to src/audit/secret-scan-cli.ts.

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

npm run build --silent
exec node dist/src/audit/secret-scan-cli.js "$@"
