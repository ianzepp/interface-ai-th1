{
  "capabilityVersion": "0.1.0",
  "contract": {
    "goal": "Look up a Dolibarr third party by exact name and return its account profile.",
    "inputs": {
      "baseUrl": "string",
      "name": "string"
    },
    "outputs": {
      "currency": "string",
      "customerCode": "string",
      "name": "string",
      "nature": "string",
      "status": "string",
      "vendorCode": "string"
    },
    "successCondition": "Exactly one matching third party is opened and its visible account fields are returned."
  },
  "entryStageId": "open-list",
  "id": "dolibarr.lookup-third-party",
  "policy": {
    "allowedActionTypes": [
      "navigate",
      "fill",
      "activate"
    ],
    "allowedOrigins": [
      "http://127.0.0.1:8080"
    ],
    "riskyActionMode": "block"
  },
  "provenance": {
    "createdAt": "2026-09-15T20:17:27.769Z",
