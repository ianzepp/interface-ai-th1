  "schemaVersion": "1",
  "stages": [
    {
      "action": {
        "type": "navigate",
        "url": "{{input.baseUrl}}/societe/list.php?mainmenu=companies"
      },
      "description": "Open the protected third-party list.",
      "detectors": [
        {
          "description": "Dolibarr redirected the protected operation to its login page.",
          "id": "dolibarr-authentication-required",
          "scope": "target",
          "signals": [
            {
              "exact": true,
              "kind": "text",
              "value": "Password forgotten?"
            }
          ]
        },
        {
          "description": "dolibarr-third-party-search-ready observed by target cardinality.",
          "id": "dolibarr-third-party-search-ready",
          "scope": "capability",
          "signals": [
            {
              "kind": "count",
              "operator": "equal",
              "target": {
                "candidates": [
                  {
                    "kind": "css",
                    "selector": "input[name=\"search_nom\"]"
                  }
                ],
                "require": "exactly-one"
              },
              "value": 1
            }
          ]
        }
      ],
      "extractions": [],
      "id": "open-list",
      "otherwise": {
        "outcome": {
          "code": "unexpected-list-state",
          "type": "failure"
        },
        "type": "terminal"
      },
      "risk": "safe",
      "transitions": [
        {
          "destination": {
            "outcome": {
              "code": "authentication-required",
              "type": "intervention-required"
            },
            "type": "terminal"
          },
          "detectorId": "dolibarr-authentication-required"
        },
        {
          "destination": {
            "stageId": "fill-name",
            "type": "stage"
          },
          "detectorId": "dolibarr-third-party-search-ready"
        }
      ]
    },
    {
      "action": {
        "target": {
          "candidates": [
            {
              "kind": "css",
              "selector": "input[name=\"search_nom\"]"
            }
          ],
          "require": "exactly-one"
        },
        "type": "fill",
        "value": "{{input.name}}"
      },
      "description": "Enter the caller-provided exact third-party name.",
      "detectors": [
        {
          "description": "dolibarr-third-party-submit-ready observed by target cardinality.",
