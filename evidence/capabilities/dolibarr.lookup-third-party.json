            "type": "terminal"
          },
          "detectorId": "dolibarr-authentication-required"
        },
        {
          "destination": {
            "outcome": {
              "code": "third-party-not-found",
              "type": "business-outcome"
            },
            "type": "terminal"
          },
          "detectorId": "dolibarr-third-party-no-match"
        },
        {
          "destination": {
            "outcome": {
              "code": "third-party-ambiguous",
              "type": "business-outcome"
            },
            "type": "terminal"
          },
          "detectorId": "dolibarr-third-party-ambiguous-match"
        },
        {
          "destination": {
            "stageId": "open-result",
            "type": "stage"
          },
          "detectorId": "dolibarr-third-party-unique-match"
        }
      ]
    },
    {
      "action": {
        "target": {
          "candidates": [
            {
              "exact": true,
              "kind": "text",
              "text": "{{input.name}}"
            }
          ],
          "require": "exactly-one"
        },
        "type": "activate"
      },
      "description": "Open the sole exact-name result and return its account profile.",
      "detectors": [
        {
          "description": "Dolibarr redirected the protected operation to its login page.",
          "id": "dolibarr-authentication-required",
          "scope": "target",
          "signals": [
            {
              "exact": true,
              "kind": "text",
              "value": "Password forgotten?"
            }
          ]
        },
        {
          "description": "The selected third-party card is visible.",
          "id": "dolibarr-third-party-profile-visible",
          "scope": "capability",
          "signals": [
            {
              "kind": "url",
              "pattern": "/societe/card\\.php"
            }
          ]
        }
      ],
      "extractions": [],
      "id": "open-result",
      "otherwise": {
        "outcome": {
          "code": "unexpected-profile-state",
          "type": "failure"
        },
        "type": "terminal"
      },
      "risk": "safe",
      "transitions": [
        {
          "destination": {
            "outcome": {
              "code": "authentication-required",
              "type": "intervention-required"
            },
            "type": "terminal"
          },
          "detectorId": "dolibarr-authentication-required"
        },
        {
          "destination": {
            "stageId": "extract-profile",
            "type": "stage"
          },
          "detectorId": "dolibarr-third-party-profile-visible"
        }
      ]
    },
    {
      "description": "Extract the requested fields from the recognized profile card.",
      "detectors": [
        {
          "description": "The selected third-party card is visible.",
          "id": "dolibarr-third-party-profile-visible",
          "scope": "capability",
          "signals": [
            {
              "kind": "url",
              "pattern": "/societe/card\\.php"
            }
          ]
        }
      ],
      "extractions": [
        {
          "name": "name",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "div.refid > span.valignmiddle"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        },
        {
          "name": "customerCode",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "tr:has(> td:text-is(\"Customer Code\")) > td:nth-child(2) .clipboardCPValue"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        },
        {
          "name": "vendorCode",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "tr:has(> td:text-is(\"Vendor Code\")) > td:nth-child(2) .clipboardCPValue"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        },
        {
          "name": "currency",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "tr:has(> td:text-is(\"Currency\")) > td:nth-child(2)"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        },
        {
          "name": "status",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "div.statusref .badge-status4"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        },
        {
          "name": "nature",
          "target": {
            "candidates": [
              {
                "kind": "css",
                "selector": "tr:has(> td:text-is(\"Nature of Third party\")) > td:nth-child(2)"
              }
            ],
            "require": "exactly-one"
          },
          "type": "string"
        }
      ],
      "id": "extract-profile",
      "otherwise": {
        "outcome": {
          "code": "profile-no-longer-visible",
          "type": "failure"
        },
        "type": "terminal"
      },
      "risk": "safe",
      "transitions": [
        {
          "destination": {
            "outcome": {
              "type": "success"
            },
            "type": "terminal"
          },
          "detectorId": "dolibarr-third-party-profile-visible"
        }
      ]
    }
  ],
  "targetProfile": "dolibarr",
  "title": "Look up a Dolibarr third party by exact name"
}
