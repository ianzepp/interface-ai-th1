            {
              "kind": "count",
              "operator": "equal",
              "target": {
                "candidates": [
                  {
                    "kind": "css",
                    "selector": "button[name=\"button_search_x\"]"
                  }
                ],
                "require": "exactly-one"
              },
              "value": 1
            }
          ]
        }
      ],
      "extractions": [],
      "id": "fill-name",
      "otherwise": {
        "outcome": {
          "code": "search-form-unavailable",
          "type": "failure"
        },
        "type": "terminal"
      },
      "risk": "safe",
      "transitions": [
        {
          "destination": {
            "stageId": "submit-search",
            "type": "stage"
          },
          "detectorId": "dolibarr-third-party-submit-ready"
        }
      ]
    },
    {
      "action": {
        "target": {
          "candidates": [
            {
              "kind": "css",
              "selector": "button[name=\"button_search_x\"]"
            }
          ],
          "require": "exactly-one"
        },
        "type": "activate"
      },
      "description": "Submit the name filter and classify the result cardinality.",
      "detectors": [
        {
          "description": "Dolibarr redirected the protected operation to its login page.",
          "id": "dolibarr-authentication-required",
          "scope": "target",
          "signals": [
            {
              "exact": true,
              "kind": "text",
              "value": "Password forgotten?"
            }
          ]
        },
        {
          "description": "Dolibarr reported that the filtered list has no records.",
          "id": "dolibarr-third-party-no-match",
          "scope": "capability",
          "signals": [
            {
              "exact": true,
              "kind": "text",
              "value": "No record found"
            }
          ]
        },
        {
          "description": "dolibarr-third-party-ambiguous-match observed by target cardinality.",
          "id": "dolibarr-third-party-ambiguous-match",
          "scope": "capability",
          "signals": [
            {
              "kind": "count",
              "operator": "greater-than",
              "target": {
                "candidates": [
                  {
                    "exact": true,
                    "kind": "text",
                    "text": "{{input.name}}"
                  }
                ],
                "require": "exactly-one"
              },
              "value": 1
            }
          ]
        },
        {
          "description": "dolibarr-third-party-unique-match observed by target cardinality.",
          "id": "dolibarr-third-party-unique-match",
          "scope": "capability",
          "signals": [
            {
              "kind": "count",
              "operator": "equal",
              "target": {
                "candidates": [
                  {
                    "exact": true,
                    "kind": "text",
                    "text": "{{input.name}}"
                  }
                ],
                "require": "exactly-one"
              },
              "value": 1
            }
          ]
        }
      ],
      "extractions": [],
      "id": "submit-search",
      "otherwise": {
        "outcome": {
          "code": "unrecognized-search-result",
          "type": "failure"
        },
        "type": "terminal"
      },
      "risk": "safe",
      "transitions": [
        {
          "destination": {
            "outcome": {
              "code": "authentication-required",
